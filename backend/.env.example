# ==============================================================================
# SmartMastitis AI - Backend Environment Configuration (Render & Production)
# ==============================================================================
#
# RENDER DEPLOYMENT SETTINGS:
# ------------------------------------------------------------------------------
# Environment:         Python 3
# Root Directory:      backend
# Build Command:       pip install -r requirements.txt
# Start Command:       uvicorn app.main:app --host 0.0.0.0 --port $PORT
# Health Check Path:   /health
# ------------------------------------------------------------------------------

# --- Server & Runtime Environment ---
# Render dynamically assigns PORT (default is 10000 if running locally)
PORT=10000
ENVIRONMENT=production
DEBUG=False
PYTHON_VERSION=3.10.12

# --- Security & JWT Authentication ---
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=generate_a_secure_random_key_for_production_dairy_ai_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database Configuration ---
# Option 1 (Default SQLite): Local SQLite database (included & pre-seeded)
DATABASE_URL=sqlite:///./smartmastitis.db

# Option 2 (Render PostgreSQL): If using Render Managed PostgreSQL, uncomment & paste Internal DB URL:
# DATABASE_URL=postgresql://user:password@dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com/smartmastitis_db

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend domains
# Add your deployed frontend URL (Render / Vercel / Netlify) along with local dev URLs
ALLOWED_ORIGINS=https://smartmastitis-ai.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# --- Dairy Farm Metadata ---
FARM_ID=FARM001
FARM_NAME=Smart Dairy Farm
FARM_LOCATION=Punjab, India
